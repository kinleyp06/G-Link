# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL (same details you use in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=g_link

# Login token secret: any long random text
JWT_SECRET=change_this_to_a_long_random_secret

# Email domain(s) that count as RUB official email (comma separated).
# Only these accounts can choose the "RUB staff" rate.
RUB_EMAIL_DOMAINS=rub.edu.bt

# GST for hall bookings (room GST comes from the rates table)
GST_PERCENT=5

# Email (SMTP). Leave SMTP_HOST empty while developing:
# emails are then printed in the server terminal instead of being sent.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your gmail, SMTP_PASS=a Gmail "App password" (not your normal password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="G-Link Guest House <no-reply@glink.local>"

# Used by: npm run create-super-admin
SUPER_ADMIN_EMAIL=ict@rub.edu.bt
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=ICT
SUPER_ADMIN_LAST_NAME=Unit
