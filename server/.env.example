# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# Server
PORT=5000
# Address of the website. Links in emails (like the confirmation link) open this address.
CLIENT_URL=http://localhost:5173

# MySQL (same details you use in MySQL Workbench)
# Own laptop: localhost and your root password.
# Shared online database (one database for the whole team): the host, port, user and password the
# provider shows, plus DB_SSL=true and DB_SSL_CA=ca.pem (save the provider's CA certificate as server/ca.pem).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=g_link
DB_SSL=false
DB_SSL_CA=

# Login token secret: any long random text. With a shared database, use the SAME value on every
# laptop, or email confirmation links made on one laptop will not work on another.
JWT_SECRET=change_this_to_a_long_random_secret


# GST for hall bookings (room GST comes from the rates table)
GST_PERCENT=5

# Email (SMTP): REQUIRED. G-Link sends real emails for account confirmation, booking approval or
# rejection, cancellations, check-in and check-out. The server will not start without these.
# Gmail: turn on 2-Step Verification on the team Gmail account, then create an App password
# (Google Account > Security > App passwords) and paste the 16 letters into SMTP_PASS (no spaces).
# Your normal Gmail password will NOT work. Test it with: npm run test-email -- you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourteam@gmail.com
SMTP_PASS=
MAIL_FROM="G-Link Guest House <yourteam@gmail.com>"

# Online host that blocks SMTP (Render free plan): send through the Brevo email API instead.
# brevo.com > SMTP & API > API keys > Generate. When BREVO_API_KEY is set, Brevo is used instead of SMTP.
# BREVO_SENDER_EMAIL must be a sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Used by: npm run create-super-admin
SUPER_ADMIN_EMAIL=ict@rub.edu.bt
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=ICT
SUPER_ADMIN_LAST_NAME=Unit
