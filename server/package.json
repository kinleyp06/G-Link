{
  "name": "g-link-server",
  "version": "1.0.0",
  "description": "G-Link guest house booking system - backend (Express + MySQL)",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "create-super-admin": "node scripts/createSuperAdmin.js",
    "check-db": "node scripts/checkDb.js",
    "test-email": "node scripts/testEmail.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "mailparser": "^3.7.2",
    "nodemon": "^3.1.7",
    "smtp-server": "^3.13.6"
  },
  "engines": {
    "node": ">=22"
  }
}
